<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1150.0" style="-fx-background-color: #0f172a;" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.vistas.AdministradorVentana">
   <top>
      <VBox>
         <MenuBar style="-fx-background-color: #0b0f19;">
            <Menu text="Sistema">
               <MenuItem text="Realizar Backup de Base de Datos" />
               <MenuItem text="Cerrar Sesión" />
            </Menu>
         </MenuBar>
         <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #0b0f19; -fx-padding: 10 20;">
            <Label style="-fx-text-fill: #f1f5f9; -fx-font-size: 16px; -fx-font-weight: bold;" text="Panel de Administración del Hotel" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblUsuarioLogueado" style="-fx-text-fill: #94a3b8;" text="Administrador: Sesión Activa" />
            <Button onAction="#generarBackup" style="-fx-background-color: #1e293b; -fx-text-fill: #f1f5f9;" text="Generar Backup" />
            <Button onAction="#salir" style="-fx-background-color: #ef4444; -fx-text-fill: white;" text="Salir" />
         </HBox>
      </VBox>
   </top>
   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE">
         <Tab text="Gestión de Usuarios y Roles">
            <BorderPane>
               <left>
                  <VBox prefWidth="340.0" spacing="12.0" style="-fx-background-color: #0b0f19;">
                     <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
                     <Label style="-fx-text-fill: #f1f5f9; -fx-font-size: 15px; -fx-font-weight: bold;" text="Datos del Usuario" />
                     <ComboBox fx:id="cmbTipoUsuario" maxWidth="Infinity" promptText="Seleccione un rol..." />
                     <HBox spacing="10.0">
                        <TextField fx:id="txtNombre" promptText="Nombre" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtApellido" promptText="Apellido" HBox.hgrow="ALWAYS" />
                     </HBox>
                     <HBox spacing="10.0">
                        <TextField fx:id="txtDni" promptText="DNI" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtTelefono" promptText="Teléfono" HBox.hgrow="ALWAYS" />
                     </HBox>
                     <TextField fx:id="txtEmail" promptText="correo@hotel.com" />
                     <HBox spacing="10.0">
                        <TextField fx:id="txtNombreUsuario" promptText="Usuario" HBox.hgrow="ALWAYS" />
                        <PasswordField fx:id="txtContrasenia" promptText="Contraseña" HBox.hgrow="ALWAYS" />
                     </HBox>
                     <Separator />
                     <Label style="-fx-text-fill: #6366f1;" text="Datos de Empleado (Solo Conserje)" />
                     <HBox spacing="10.0">
                        <ComboBox fx:id="cmbTurno" maxWidth="Infinity" promptText="Turno" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtSalario" promptText="Salario ($)" HBox.hgrow="ALWAYS" />
                     </HBox>
                     <CheckBox fx:id="chkActivo" selected="true" style="-fx-text-fill: #f1f5f9;" text="Usuario Activo" />
                     <Label fx:id="lblMensajeUsuario" style="-fx-text-fill: #ef4444;" />
                     <HBox spacing="8.0">
                        <Button maxWidth="Infinity" style="-fx-background-color: #6366f1; -fx-text-fill: white;" text="Guardar" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="Infinity" style="-fx-background-color: #1e293b; -fx-text-fill: white;" text="Modificar" HBox.hgrow="ALWAYS" />
                        <Button onAction="#limpiarUsuario" style="-fx-background-color: #334155; -fx-text-fill: white;" text="Limpiar" />
                     </HBox>
                  </VBox>
               </left>
               <center>
                  <VBox spacing="12.0">
                     <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
                     <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label style="-fx-text-fill: #f1f5f9; -fx-font-size: 15px; -fx-font-weight: bold;" text="Usuarios Registrados" />
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtBuscarUsuario" prefWidth="250.0" promptText="Buscar por DNI, nombre o rol..." />
                     </HBox>
                     <TableView fx:id="tablaUsuarios" onMouseClicked="#completarConClickUsuario" VBox.vgrow="ALWAYS">
                        <columns>
                           <TableColumn fx:id="colUsuarioId" text="ID" />
                           <TableColumn fx:id="colNombre" text="Nombre" />
                           <TableColumn fx:id="colApellido" text="Apellido" />
                           <TableColumn fx:id="colDni" text="DNI" />
                           <TableColumn fx:id="colEmail" text="Email" />
                           <TableColumn fx:id="colRol" text="Rol" />
                           <TableColumn fx:id="colActivo" text="Activo" />
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                     </TableView>
                  </VBox>
               </center>
            </BorderPane>
         </Tab>
         <Tab text="Configuración de Habitaciones">
            <BorderPane>
               <left>
                  <VBox prefWidth="340.0" spacing="14.0" style="-fx-background-color: #0b0f19;">
                     <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
                     <Label style="-fx-text-fill: #f1f5f9; -fx-font-size: 15px; -fx-font-weight: bold;" text="Administrar Habitación" />
                     <TextField fx:id="txtNumeroHabitacion" promptText="Número de Habitación (Ej: 101)" />
                     <ComboBox fx:id="cmbTipoHabitacion" maxWidth="Infinity" promptText="Tipo de Habitación" />
                     <ComboBox fx:id="cmbEstadoHabitacion" maxWidth="Infinity" promptText="Estado Actual" />
                     <ComboBox fx:id="cmbMotivoBloqueo" maxWidth="Infinity" promptText="Motivo de Bloqueo" />
                     <Label fx:id="lblMensajeHabitacion" style="-fx-text-fill: #ef4444;" />
                     <HBox spacing="8.0">
                        <Button maxWidth="Infinity" style="-fx-background-color: #6366f1; -fx-text-fill: white;" text="Guardar" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="Infinity" style="-fx-background-color: #1e293b; -fx-text-fill: white;" text="Actualizar" HBox.hgrow="ALWAYS" />
                        <Button onAction="#limpiarHabitacion" style="-fx-background-color: #334155; -fx-text-fill: white;" text="Limpiar" />
                     </HBox>
                  </VBox>
               </left>
               <center>
                  <VBox spacing="12.0">
                     <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
                     <Label style="-fx-text-fill: #f1f5f9; -fx-font-size: 15px; -fx-font-weight: bold;" text="Inventario de Habitaciones" />
                     <TableView fx:id="tablaHabitaciones" onMouseClicked="#completarConClickHabitacion" VBox.vgrow="ALWAYS">
                        <columns>
                           <TableColumn fx:id="colHabId" text="ID" />
                           <TableColumn fx:id="colNumHab" text="Número" />
                           <TableColumn fx:id="colTipoHab" text="Tipo" />
                           <TableColumn fx:id="colEstadoHab" text="Estado" />
                           <TableColumn fx:id="colMotivoBloqueo" text="Motivo Bloqueo" />
                           <TableColumn fx:id="colHabActiva" text="Activa" />
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                     </TableView>
                  </VBox>
               </center>
            </BorderPane>
         </Tab>
      </TabPane>
   </center>
</BorderPane>
