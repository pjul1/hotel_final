<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.vistas.PasajeroVentana">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #0b0f19; -fx-padding: 15 25; -fx-border-color: #1e293b; -fx-border-width: 0 0 1px 0;">
         <Label style="-fx-text-fill: #f1f5f9; -fx-font-size: 18px; -fx-font-weight: bold;" text="Portal del Pasajero - Reservas y Servicios" />
         <Region HBox.hgrow="ALWAYS" />
         <Label fx:id="lblNombrePasajero" style="-fx-text-fill: #94a3b8; -fx-font-weight: bold;" text="Bienvenido, Pasajero" />
         <Button fx:id="btnCerrarSesion" onAction="#cerrarSesion" style="-fx-background-color: #ef4444;" text="Cerrar Sesión" />
      </HBox>
   </top>
   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE">
         <Tab text="Mis Reservas y Nueva Reserva">
            <BorderPane>
               <left>
                  <VBox prefWidth="340.0" spacing="12.0" styleClass="vbox-form">
                     <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
                     <Label style="-fx-text-fill: #f1f5f9; -fx-font-size: 15px; -fx-font-weight: bold;" text="Reservar Habitación" />
                     <Label text="Fecha de Ingreso *" />
                     <DatePicker fx:id="dpFechaIngreso" maxWidth="Infinity" onAction="#actualizarDisponibilidadYPrecio" promptText="Seleccione fecha" />
                     <HBox spacing="10.0">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <Label text="Días de Estadía *" />
                           <TextField fx:id="txtDuracionEstadia" onKeyReleased="#actualizarDisponibilidadYPrecio" promptText="Ej: 3" />
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <Label text="Pasajeros *" />
                           <TextField fx:id="txtCantidadPasajeros" promptText="Ej: 2" />
                        </VBox>
                     </HBox>
                     <Label text="Tipo de Habitación *" />
                     <ComboBox fx:id="cmbTipoHabitacion" maxWidth="Infinity" onAction="#actualizarDisponibilidadYPrecio" promptText="Simple / Doble / Suite..." />
                     <Label text="Habitación Disponible *" />
                     <ComboBox fx:id="cmbHabitacionDisponible" maxWidth="Infinity" promptText="Seleccione habitación..." />
                     <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #1e293b; -fx-padding: 10; -fx-background-radius: 6px;">
                        <Label text="Total Estimado:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblPrecioTotal" style="-fx-text-fill: #6366f1; -fx-font-size: 16px; -fx-font-weight: bold;" text="\$ 0.00" />
                     </HBox>
                     <Label fx:id="lblMensajeReserva" style="-fx-text-fill: #ef4444;" wrapText="true" />
                     <Button fx:id="btnConfirmarReserva" maxWidth="Infinity" onAction="#confirmarReserva" text="Confirmar Reserva" />
                  </VBox>
               </left>
               <center>
                  <VBox spacing="12.0">
                     <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
                     <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label style="-fx-text-fill: #f1f5f9; -fx-font-size: 15px; -fx-font-weight: bold;" text="Historial y Reservas Activas" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnCancelarReserva" onAction="#cancelarReservaSeleccionada" style="-fx-background-color: #334155;" text="Cancelar Reserva Seleccionada" />
                     </HBox>
                     <TableView fx:id="tablaReservas" VBox.vgrow="ALWAYS">
                        <columns>
                           <TableColumn fx:id="colReservaId" text="N° Reserva" />
                           <TableColumn fx:id="colHabitacion" text="Habitación" />
                           <TableColumn fx:id="colFechaReservada" text="Fecha Ingreso" />
                           <TableColumn fx:id="colDias" text="Días" />
                           <TableColumn fx:id="colPasajeros" text="Pasajeros" />
                           <TableColumn fx:id="colPrecio" text="Total ($)" />
                           <TableColumn fx:id="colEstadoReserva" text="Estado" />
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                     </TableView>
                  </VBox>
               </center>
            </BorderPane>
         </Tab>
      </TabPane>
   </center>
</BorderPane>
